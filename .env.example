# Copy to .env and fill in. Never commit .env.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
SARVAM_API_KEY=
# Sarvam model ids (W3.1). Blank = the default. See docs/SARVAM_API_NOTES.md.
# (No comments after a value: the .env reader takes everything after "=" as the value.)
# Speech-to-text model: saaras:v3 by default; the docs recommend saaras:v4.
SARVAM_STT_MODEL=
# Speech-to-text mode: transcribe (default), translate, verbatim, translit or codemix.
SARVAM_STT_MODE=
# Text-to-speech model: bulbul:v3 by default; bulbul:v4-flash needs its own speaker id (set SARVAM_TTS_SPEAKER too).
SARVAM_TTS_MODEL=
# Speaker id; blank = the model's own default.
SARVAM_TTS_SPEAKER=
# Chat model for the ride-check fallback: sarvam-105b (default) or sarvam-105b-conversations.
SARVAM_CHAT_MODEL=
# Chat reasoning: low (default), medium, high, none (sends null: thinking off) or omit (sends nothing).
SARVAM_CHAT_REASONING=
# Open Charge Map (free key from openchargemap.org); scripts/import_chargers.py skips OCM without it
OCM_API_KEY=
# Optional routing / elevation service keys if you use a keyed provider
ROUTING_API_KEY=
# API hardening (W0.7). Blank or unset = the default noted on each line.
# Comma-separated browser origins that may call the API. When set it REPLACES the built-in list
# (file:// pages, localhost:5500, 127.0.0.1:5500 and the GitHub Pages site), so list every origin you need.
VERITY_CORS_ORIGINS=
# Voice calls (tts + stt together) allowed per client address per minute; every call is a paid Sarvam call. Default 20.
VERITY_VOICE_RATE_PER_MIN=
# Set to 1 ONLY behind exactly one proxy that appends X-Forwarded-For (a hosted deploy). Otherwise every visitor behind
# the proxy shares one voice budget. Default off. The app then reads the last X-Forwarded-For entry itself and ignores
# what uvicorn made of it: uvicorn rewrites the client from that header for peers in FORWARDED_ALLOW_IPS, and with
# FORWARDED_ALLOW_IPS=* it takes the leftmost entry, which a caller can forge.
VERITY_TRUST_PROXY=
